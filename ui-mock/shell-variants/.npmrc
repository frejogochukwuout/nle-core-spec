# Storybook 10 (10.6) builder peers accept this app's Vite 8 pin —
# @storybook/react-vite 10.6 peers on Vite ^5||^6||^7||^8, so the old
# Storybook-9-era ERESOLVE is gone. The relaxed resolution stays: Vite 8
# itself lists peerOptional @vitejs/devtools that isn't installed, and the
# tree was first resolved this way (the resolution npm's own ERESOLVE report
# recommended at the time). Verified on SB 10.6 + Vite 8: installs clean,
# stories render, tsc --noEmit passes.
legacy-peer-deps=true
